<h3 local-id=3D"ace641a8581b" id=3D"id-=C4=90=E1=BA=B7ct=E1=BA=A3c=E1=BA=AD=
pnh=E1=BA=ADtth=C3=B4ngtingi=E1=BA=A3ing=C3=A2ntheoHHDVt=E1=BA=A1iS6-1.2Pop=
up&quot;Ch=E1=BB=89nhs=E1=BB=ADath=C3=B4ngtingi=E1=BA=A3ing=C3=A2ntheoHHDV&=
quot;">1.2 Popup "Ch=E1=BB=89nh s=E1=BB=ADa th=C3=B4ng tin gi=E1=BA=A3i ng=
=C3=A2n theo HHDV"</h3>
<ul local-id=3D"140ce8f7">
<li local-id=3D"24759219">
<p local-id=3D"ec876120aa50"><strong>B=E1=BA=A3ng KH-01, KH-02:</strong> hi=
=E1=BB=83n th=E1=BB=8B d=E1=BA=A1ng table, read-only, ngu=E1=BB=93n nh=C6=
=B0 tab. C=C3=A1c c=E1=BB=99t gi=E1=BB=91ng tab, ri=C3=AAng c=E1=BB=99t <st=
rong>S=E1=BB=91 ti=E1=BB=81n gi=E1=BA=A3i ng=C3=A2n l=E1=BA=A7n n=C3=A0y</s=
trong> chuy=E1=BB=83n th=C3=A0nh =C3=B4 nh=E1=BA=ADp. B=E1=BA=A3ng K=E1=BA=
=BF ho=E1=BA=A1ch 02 m=E1=BB=9F s=E1=BA=B5n c=C3=A1c d=C3=B2ng con.</p>
</li>
<li local-id=3D"6b5a65f3">
<p local-id=3D"9ca03ef9318a"><strong>S=E1=BB=91 ti=E1=BB=81n gi=E1=BA=A3i n=
g=C3=A2n l=E1=BA=A7n n=C3=A0y:</strong> B=E1=BA=AFt bu=E1=BB=99c nh=E1=BA=
=ADp v=C3=A0 cho ph=C3=A9p ch=E1=BB=89nh s=E1=BB=ADa. Ng=C6=B0=E1=BB=9Di d=
=C3=B9ng nh=E1=BA=ADp gi=C3=A1 tr=E1=BB=8B theo tu=E1=BB=B3 b=E1=BA=A3ng K=
=E1=BA=BF ho=E1=BA=A1ch:</p>
<ul local-id=3D"9767e97fe821">
<li local-id=3D"9708a9b63014">
<p local-id=3D"600bc5230c8d">V=E1=BB=9Bi KH-01, nh=E1=BA=ADp t=E1=BA=A1i d=
=C3=B2ng HHDV.</p>
</li>
<li local-id=3D"a12757193fda">
<p local-id=3D"5019dfe2a218">V=E1=BB=9Bi KH-02, nh=E1=BA=ADp t=E1=BA=A1i t=
=E1=BB=ABng d=C3=B2ng con =C4=90V/PB, d=C3=B2ng HHDV t=E1=BB=B1 t=C3=ADnh t=
=E1=BB=95ng.</p>
</li>
<li local-id=3D"0be5c3370283">
<p local-id=3D"05e76d586f40">Quy t=E1=BA=AFc chung: Gi=C3=A1 tr=E1=BB=8B m=
=E1=BA=B7c =C4=91=E1=BB=8Bnh l=C3=A0 s=E1=BB=91 =C4=91=C3=A3 l=C6=B0u, l=E1=
=BA=A7n =C4=91=E1=BA=A7u b=E1=BA=B1ng 0. Khi vi ph=E1=BA=A1m BR-04, BR-05, =
=C3=B4 nh=E1=BA=ADp =C4=91=C6=B0=E1=BB=A3c vi=E1=BB=81n =C4=91=E1=BB=8F v=
=C3=A0 hi=E1=BB=83n th=E1=BB=8B th=C3=B4ng b=C3=A1o l=E1=BB=97i b=C3=AAn d=
=C6=B0=E1=BB=9Bi. KH-02, l=E1=BB=97i theo BR-04 hi=E1=BB=83n th=E1=BB=8B t=
=E1=BA=A1i d=C3=B2ng HHDV, l=E1=BB=97i theo BR-05 hi=E1=BB=83n th=E1=BB=8B =
t=E1=BA=A1i d=C3=B2ng con.</p>
</li>
</ul>
</li>
<li local-id=3D"09e39aac">
<p local-id=3D"5717c699d164"><strong>T=E1=BB=95ng c=E1=BB=99ng:</strong> hi=
=E1=BB=83n th=E1=BB=8B d=E1=BA=A1ng OutputText, ki=E1=BB=83u d=E1=BB=AF li=
=E1=BB=87u Decimal, kh=C3=B4ng b=E1=BA=AFt bu=E1=BB=99c, read-only, ngu=E1=
=BB=93n t=C3=ADnh to=C3=A1n. Gi=C3=A1 tr=E1=BB=8B =C4=91=C6=B0=E1=BB=A3c c=
=E1=BA=ADp nh=E1=BA=ADt ngay khi ng=C6=B0=E1=BB=9Di d=C3=B9ng nh=E1=BA=ADp.=
</p>
</li>
<li local-id=3D"5ca8e813">
<p local-id=3D"02aab34a847c"><strong>H=E1=BB=A7y:</strong> button =C4=91=C3=
=B3ng popup v=C3=A0 gi=E1=BB=AF nguy=C3=AAn d=E1=BB=AF li=E1=BB=87u =C4=91=
=C3=A3 l=C6=B0u tr=C6=B0=E1=BB=9Bc =C4=91=C3=B3.</p>
</li>
<li local-id=3D"1de6bbad">
<p local-id=3D"0c3d13033471"><strong>L=C6=B0u:</strong> button ki=E1=BB=83m=
 tra BR-04, BR-05, l=C6=B0u d=E1=BB=AF li=E1=BB=87u v=C3=A0 c=E1=BA=ADp nh=
=E1=BA=ADt l=E1=BA=A1i tab c=C3=B9ng ph=E1=BA=A7n Th=C3=B4ng tin t=C3=B3m t=
=E1=BA=AFt.</p>
</li>
</ul>
